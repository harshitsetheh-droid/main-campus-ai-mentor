# PostgreSQL connection string
DATABASE_URL="postgres://postgres:postgres@localhost:5432/campus_ai_mentor"

# Gemini API key for AI mentor chat (optional - server falls back to canned reply)
GEMINI_API_KEY=""

# Backend port
PORT=5000

# JWT secret used to sign auth tokens
JWT_SECRET="change-me-to-a-long-random-string"

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=""

# Supabase service_role key (secret — Dashboard -> Settings -> API). Used for
# file storage only; uploads go to the "resumes" Storage bucket instead of disk.
SUPABASE_SERVICE_ROLE_KEY=""
